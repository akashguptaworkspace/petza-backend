# Copy to .env for local (non-Docker) development. Never commit the real .env.
# Docker/compose setups instead point NODE_ENV-specific files (.env.dev /
# .env.testing / .env.prod) at this service via `env_file:` — see
# jipanditji-docker/jipanditji-infra/docker-compose.*.yml for the pattern
# this mirrors.

NODE_ENV=development
PORT=4000

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=petza_dev
DATABASE_USERNAME=petza
DATABASE_PASSWORD=
DATABASE_DIALECT=mysql

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Google Identity Services client IDs (audiences) used to verify "Sign in with
# Google" credentials. COMMA-SEPARATED — petza-app and petza-partner are
# separate Google Cloud projects, and an ID token carries the minting client's
# own id in `aud`, so both apps' Android client ids must be listed here or the
# one that's missing gets a 401 on an otherwise valid sign-in. Append each new
# client (iOS/web, once registered); never replace what's already there.
GOOGLE_CLIENT_ID=

# OTP login/registration (email + SMS)
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
DEFAULT_COUNTRY_CODE=+91

# Optional Play Console / app-store review login helper. When both are set,
# only these normalized LOGIN identifiers accept the fixed 6-digit OTP.
# Seeded customer reviewer identifiers: reviewer@petza.app,+919999000001
PLAY_REVIEW_IDENTIFIERS=
PLAY_REVIEW_OTP=

# Email OTP delivery — if unset in development, the OTP is logged to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Petza
SMTP_FROM_EMAIL=
SMTP_CONNECTION_TIMEOUT_MS=10000

# SMS OTP delivery — not wired to a vendor yet; if unset in development, the OTP is logged to the server console instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Rate limiting. AUTH_RATE_LIMIT_MAX covers login/OTP/password routes only —
# raise it if many real users share one NAT'd IP. Both are per-IP, per-window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Comma-separated list of allowed origins, e.g. https://app.petza.app,https://partner.petza.app
CORS_ORIGIN=*

PAYMENT_PROVIDER=
PAYMENT_SECRET=

LOG_LEVEL=info

# One-call DB bootstrap — POST /api/v1/system/seed runs `db:migrate` then
# `db:seed:all`. SEED_KEY is the shared secret Postman sends as the
# X-Seed-Key header on a fresh VM (no admin user exists yet to log in as);
# once seeded, an admin JWT works instead. Blocked entirely when
# NODE_ENV=production unless ALLOW_SEED_ROUTE=true.
SEED_KEY=
ALLOW_SEED_ROUTE=false
