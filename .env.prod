# Copy to .env for local (non-Docker) development. Never commit the real .env.
# Docker/compose setups instead point NODE_ENV-specific files (.env.dev /
# .env.testing / .env.prod) at this service via `env_file:` — see
# jipanditji-docker/jipanditji-infra/docker-compose.*.yml for the pattern
# this mirrors.

NODE_ENV=development
PORT=4000

# API base path exposed to clients, e.g. https://api.petza.app/api/v1

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=petza_dev
DATABASE_USERNAME=petza
DATABASE_PASSWORD=PetzaLocalDev_2026!
DATABASE_DIALECT=mysql

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

GOOGLE_CLIENT_ID=8150684229-tg6p7hbuju7dprhd1l54rdt4c8g5g3jq.apps.googleusercontent.com

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
DEFAULT_COUNTRY_CODE=+91

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Petza
SMTP_FROM_EMAIL=
SMTP_CONNECTION_TIMEOUT_MS=10000

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Comma-separated list of allowed origins, e.g. https://app.petza.app,https://partner.petza.app
CORS_ORIGIN=*

PAYMENT_PROVIDER=
PAYMENT_SECRET=

LOG_LEVEL=info

# One-call DB bootstrap — POST /api/v1/system/seed. Send this as the
# X-Seed-Key header in Postman.
SEED_KEY=local-dev-seed-key-change-me
ALLOW_SEED_ROUTE=false
